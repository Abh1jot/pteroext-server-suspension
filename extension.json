{
    "$schema": "https://raw.githubusercontent.com/pterodactyl/panel/2.0-develop/packages/sdk/manifest.schema.json",
    "id": "server-suspension",
    "name": "Auto Server Suspension",
    "version": "2.0.0",
    "description": "Automated server expiration scheduler with custom suspension dates, owner email notifications, and grace-period termination.",
    "author": "Azion",
    "requires": {
        "sdk": ">=2.0.0-beta.5 <3.0",
        "php": ">=8.2"
    },
    "provider": "ServerSuspension\\ServerSuspensionProvider",
    "autoload": {
        "ServerSuspension\\": "src"
    },
    "ui": {
        "entry": "dist/client.js",
        "screens": [
            {
                "id": "admin-suspension",
                "area": "admin",
                "path": "server-suspension",
                "nav": {
                    "label": "Suspensions",
                    "order": 55,
                    "icon": "shield-alert"
                }
            }
        ],
        "mode": "native",
        "prefix": "ssusp"
    }
}
